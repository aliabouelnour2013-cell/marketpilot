# PostgreSQL connection string.
# Local (docker compose): postgresql://marketpilot:marketpilot@localhost:5432/marketpilot
# Hosted: use your provider's connection string (e.g. Neon, Supabase).
DATABASE_URL=

# Auth.js session encryption secret. Generate with: npx auth secret
AUTH_SECRET=
# Set to "true" when running behind a proxy in production (e.g. Vercel).
# AUTH_TRUST_HOST=true

# App URL used for Stripe redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe billing (server). Keys live ONLY in the server environment —
# never commit them, never paste them into chat.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from the Stripe dashboard (Developers -> Webhooks).
STRIPE_WEBHOOK_SECRET=
# Price ids for the MarketPilot Premium product (Product catalog -> Prices).
STRIPE_PRICE_ID_PREMIUM_MONTHLY=
STRIPE_PRICE_ID_PREMIUM_YEARLY=

# Google Gemini (AI Analyst). Server-only.
GEMINI_API_KEY=
# Override if Google renames models; must support JSON response mode.
GEMINI_MODEL=gemini-2.5-flash

# Future provider keys (not yet wired).
SEC_API_KEY=
MARKET_DATA_API_KEY=
NEWS_API_KEY=
AI_API_KEY=
